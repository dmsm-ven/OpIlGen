<Window
    x:Class="OpIlGen.Views.MusicWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="clr-namespace:OpIlGen.Localization"
    Title="{loc:Loc music.title}"
    Width="1000"
    Height="640"
    MinWidth="720"
    MinHeight="460"
    Background="{DynamicResource WindowBackgroundBrush}"
    Foreground="{DynamicResource TextBrush}"
    WindowStartupLocation="CenterOwner">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </Window.Resources>

    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3*" />
            <ColumnDefinition Width="2*" MinWidth="300" />
        </Grid.ColumnDefinitions>

        <!--  Холст: фон всегда тёмный, как на главном окне  -->
        <Border
            Grid.Column="0"
            Margin="0,0,12,0"
            Background="#FF202020"
            BorderBrush="{DynamicResource ControlBorderBrush}"
            BorderThickness="1">
            <Canvas x:Name="ResultCanvas" ClipToBounds="True">
                <Image
                    Width="{Binding ActualWidth, ElementName=ResultCanvas}"
                    Height="{Binding ActualHeight, ElementName=ResultCanvas}"
                    Source="{Binding ResultImage}"
                    Stretch="Uniform" />
            </Canvas>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!--  Что пришло с главного окна  -->
            <StackPanel Grid.Row="0" Margin="0,0,0,10">
                <TextBlock TextTrimming="CharacterEllipsis">
                    <Run FontWeight="SemiBold" Text="{loc:Loc gif.file}" /><Run Text="{Binding SourceName, Mode=OneWay}" />
                </TextBlock>
                <TextBlock Margin="0,2,0,0" TextTrimming="CharacterEllipsis">
                    <Run FontWeight="SemiBold" Text="{loc:Loc gif.transformer}" /><Run Text="{Binding TransformerName, Mode=OneWay}" />
                </TextBlock>
            </StackPanel>

            <!--  FPS: сколько раз в секунду обновляется изображение  -->
            <Grid Grid.Row="1" Margin="0,0,0,10" ToolTip="{loc:Loc music.fps.tooltip}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="40" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    Grid.Column="0"
                    Margin="0,0,10,0"
                    VerticalAlignment="Center"
                    Text="{loc:Loc music.fps}" />
                <!--  Minimum/Maximum должны идти раньше Value (границы совпадают с MusicViewModel.MinFps/MaxFps)  -->
                <Slider
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    IsSnapToTickEnabled="True"
                    LargeChange="5"
                    Maximum="30"
                    Minimum="1"
                    SmallChange="1"
                    TickFrequency="1"
                    Value="{Binding Fps, Mode=TwoWay}" />
                <TextBlock
                    Grid.Column="2"
                    VerticalAlignment="Center"
                    Text="{Binding FpsText}"
                    TextAlignment="Right" />
            </Grid>

            <!--  Выбор музыкального файла  -->
            <Grid Grid.Row="2" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button
                    Grid.Column="0"
                    Margin="0,0,10,0"
                    Padding="12,4"
                    Command="{Binding SelectMusicCommand}"
                    Content="{loc:Loc music.select}"
                    Style="{StaticResource TextButton}" />
                <TextBlock
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Text="{Binding MusicName}"
                    TextTrimming="CharacterEllipsis" />
            </Grid>

            <!--  Зависимости: параметр преобразователя <- характеристика звука  -->
            <GroupBox
                Grid.Row="3"
                Header="{loc:Loc music.mapping.header}"
                Padding="6"
                Visibility="{Binding HasMappings, Converter={StaticResource BoolToVisibility}}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Mappings}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,0,0,10" ToolTip="{Binding Description}">
                                    <TextBlock FontWeight="SemiBold" Text="{Binding Name}" TextWrapping="Wrap" />
                                    <ComboBox
                                        Margin="0,4,0,0"
                                        DisplayMemberPath="Label"
                                        ItemsSource="{Binding Options}"
                                        SelectedValue="{Binding SelectedSource}"
                                        SelectedValuePath="Source" />
                                    <TextBlock
                                        Margin="0,3,0,0"
                                        FontSize="11"
                                        Opacity="0.75"
                                        Text="{Binding CurrentValueText}" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </GroupBox>

            <!--  Громкость плеера (логарифмическая шкала); на анализ звука не влияет  -->
            <Grid Grid.Row="4" Margin="0,10,0,0" ToolTip="{loc:Loc music.volume.tooltip}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="72" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    Grid.Column="0"
                    Margin="0,0,8,0"
                    VerticalAlignment="Center"
                    FontFamily="Segoe MDL2 Assets"
                    FontSize="16"
                    Text="&#xE767;" />
                <!--  Minimum/Maximum должны идти раньше Value  -->
                <Slider
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    IsMoveToPointEnabled="True"
                    LargeChange="0.1"
                    Maximum="1"
                    Minimum="0"
                    SmallChange="0.01"
                    Value="{Binding VolumePosition, Mode=TwoWay}" />
                <TextBlock
                    Grid.Column="2"
                    VerticalAlignment="Center"
                    FontSize="11"
                    Text="{Binding VolumeText}"
                    TextAlignment="Right" />
            </Grid>

            <!--  Позиция трека: тянуть можно во время воспроизведения  -->
            <Grid Grid.Row="5" Margin="0,6,0,0" ToolTip="{loc:Loc music.position.tooltip}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="92" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    Grid.Column="0"
                    Margin="0,0,8,0"
                    VerticalAlignment="Center"
                    FontFamily="Segoe MDL2 Assets"
                    FontSize="16"
                    Text="&#xE916;" />
                <Slider
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    IsEnabled="{Binding IsPlaying}"
                    IsMoveToPointEnabled="True"
                    LargeChange="10"
                    Maximum="{Binding DurationSeconds}"
                    Minimum="0"
                    SmallChange="1"
                    Thumb.DragCompleted="PositionSlider_DragCompleted"
                    Thumb.DragStarted="PositionSlider_DragStarted"
                    Value="{Binding PositionSeconds, Mode=TwoWay}" />
                <TextBlock
                    Grid.Column="2"
                    VerticalAlignment="Center"
                    FontSize="11"
                    Text="{Binding PositionText}"
                    TextAlignment="Right" />
            </Grid>

            <!--  Play / Stop  -->
            <StackPanel Grid.Row="6" Margin="0,10,0,10" Orientation="Horizontal">
                <Button
                    Margin="0,0,8,0"
                    Padding="16,4"
                    Command="{Binding PlayCommand}"
                    Content="{loc:Loc music.play}"
                    Style="{StaticResource TextButton}" />
                <Button
                    Padding="16,4"
                    Command="{Binding StopCommand}"
                    Content="{loc:Loc music.stop}"
                    Style="{StaticResource TextButton}" />
            </StackPanel>

            <StackPanel Grid.Row="7">
                <ProgressBar
                    Height="6"
                    Margin="0,0,0,6"
                    IsIndeterminate="True"
                    Visibility="{Binding IsAnalyzing, Converter={StaticResource BoolToVisibility}}" />
                <TextBlock Text="{Binding Status}" TextWrapping="Wrap" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
