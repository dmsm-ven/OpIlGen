<Window
    x:Class="OpIlGen.Views.MusicWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="clr-namespace:OpIlGen.Localization"
    Title="{loc:Loc music.title}"
    Width="1000"
    Height="640"
    MinWidth="720"
    MinHeight="460"
    Background="{DynamicResource WindowBackgroundBrush}"
    Foreground="{DynamicResource TextBrush}"
    WindowStartupLocation="CenterOwner">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <!--  Плитка недавнего трека: квадрат со скруглением; текущий выделен рамкой цвета выделения  -->
        <Style x:Key="RecentTrackTile" TargetType="Button">
            <Setter Property="Width" Value="42" />
            <Setter Property="Height" Value="42" />
            <Setter Property="Margin" Value="3" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border
                                x:Name="Bd"
                                Background="{DynamicResource HoverBrush}"
                                BorderBrush="{DynamicResource ControlBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="10" />
                            <Border x:Name="Hl" Background="Transparent" CornerRadius="10" />
                            <TextBlock
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontFamily="Segoe MDL2 Assets"
                                FontSize="20"
                                Foreground="{DynamicResource TextBrush}"
                                Text="&#xE8D6;" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Hl" Property="Background" Value="{DynamicResource HoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Hl" Property="Background" Value="{DynamicResource PressedBrush}" />
                            </Trigger>
                            <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource SelectionBrush}" />
                                <Setter TargetName="Bd" Property="BorderThickness" Value="2" />
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SelectionBrush}" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3*" />
            <ColumnDefinition Width="2*" MinWidth="300" />
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0" Margin="0,0,12,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!--  Недавние треки (общие для всех преобразователей, до 8). Первый - выбранный сейчас  -->
            <Border
                Grid.Row="0"
                Height="60"
                Margin="0,0,0,8"
                Padding="4"
                Background="{DynamicResource PanelBackgroundBrush}"
                BorderBrush="{DynamicResource ControlBorderBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <Grid>
                    <TextBlock
                        Margin="8,0"
                        VerticalAlignment="Center"
                        Opacity="0.6"
                        Text="{loc:Loc music.recent.empty}"
                        TextTrimming="CharacterEllipsis"
                        Visibility="{Binding HasNoRecentTracks, Converter={StaticResource BoolToVisibility}}" />
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding RecentTracks}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button
                                        Command="{Binding DataContext.SelectRecentCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}"
                                        Style="{StaticResource RecentTrackTile}"
                                        ToolTip="{Binding ToolTipText}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>

    <!--  Холст: фон всегда тёмный, как на главном окне  -->
            <Border
                Grid.Row="1"
                Background="#FF202020"
                BorderBrush="{DynamicResource ControlBorderBrush}"
                BorderThickness="1">
                <!--  Двойной клик по изображению открывает его на весь экран (картинка там продолжает меняться под музыку)  -->
                <Border.InputBindings>
                    <MouseBinding Command="{Binding ShowFullScreenCommand}" Gesture="LeftDoubleClick" />
                </Border.InputBindings>
                <Canvas x:Name="ResultCanvas" ClipToBounds="True">
                    <Image
                        Width="{Binding ActualWidth, ElementName=ResultCanvas}"
                        Height="{Binding ActualHeight, ElementName=ResultCanvas}"
                        Source="{Binding ResultImage}"
                        Stretch="Uniform" />
                </Canvas>
            </Border>

            </Grid>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!--  Что пришло с главного окна  -->
            <StackPanel Grid.Row="0" Margin="0,0,0,10">
                <TextBlock TextTrimming="CharacterEllipsis">
                    <Run FontWeight="SemiBold" Text="{loc:Loc gif.file}" /><Run Text="{Binding SourceName, Mode=OneWay}" />
                </TextBlock>
                <TextBlock Margin="0,2,0,0" TextTrimming="CharacterEllipsis">
                    <Run FontWeight="SemiBold" Text="{loc:Loc gif.transformer}" /><Run Text="{Binding TransformerName, Mode=OneWay}" />
                </TextBlock>
            </StackPanel>

            <!--  Выбор музыкального файла  -->
            <Grid Grid.Row="1" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button
                    Grid.Column="0"
                    Margin="0,0,10,0"
                    Padding="12,4"
                    Command="{Binding SelectMusicCommand}"
                    Content="{loc:Loc music.select}"
                    Style="{StaticResource TextButton}" />
                <TextBlock
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Text="{Binding MusicName}"
                    TextTrimming="CharacterEllipsis" />
            </Grid>

            <!--  Зависимости: параметр преобразователя <- характеристика звука  -->
            <GroupBox
                Grid.Row="2"
                Header="{loc:Loc music.mapping.header}"
                Padding="6"
                Visibility="{Binding HasMappings, Converter={StaticResource BoolToVisibility}}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl Margin="0,0,4,0" ItemsSource="{Binding Mappings}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border
                                    Margin="0,0,0,8"
                                    Padding="12,10"
                                    Background="{DynamicResource HoverBrush}"
                                    BorderBrush="{DynamicResource ControlBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    ToolTip="{Binding Description}">
                                <StackPanel>
                                    <TextBlock FontWeight="SemiBold" Text="{Binding Name}" TextWrapping="Wrap" />
                                    <ComboBox
                                        Margin="0,4,0,0"
                                        DisplayMemberPath="Label"
                                        ItemsSource="{Binding Options}"
                                        SelectedValue="{Binding SelectedSource}"
                                        SelectedValuePath="Source" />

                                    <!--  Фиксированное значение: слайдер и точный ввод числа (Enter или потеря фокуса применяют ввод)  -->
                                    <Grid Margin="0,6,0,0" Visibility="{Binding IsFixed, Converter={StaticResource BoolToVisibility}}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <!--  Minimum/Maximum должны идти раньше Value  -->
                                        <Slider
                                            Grid.Column="0"
                                            VerticalAlignment="Center"
                                            IsSnapToTickEnabled="True"
                                            Maximum="{Binding Variable.MaxValue}"
                                            Minimum="{Binding Variable.MinValue}"
                                            TickFrequency="{Binding Variable.Step}"
                                            Value="{Binding FixedValue, Delay=150}" />
                                        <TextBox
                                            Grid.Column="1"
                                            Width="64"
                                            Margin="8,0,0,0"
                                            VerticalContentAlignment="Center"
                                            KeyDown="FixedValueTextBox_KeyDown"
                                            Text="{Binding FixedValue, StringFormat={}{0:0.##}, UpdateSourceTrigger=LostFocus}"
                                            TextAlignment="Right" />
                                    </Grid>
                                    <TextBlock
                                        Margin="0,3,0,0"
                                        FontSize="11"
                                        Opacity="0.75"
                                        Text="{Binding CurrentValueText}" />
                                </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </GroupBox>

            <!--
                Громкость, позиция трека и FPS в одной сетке: одинаковые колонки,
                поэтому все три ползунка одной длины независимо от подписи справа
            -->
            <Grid Grid.Row="3" Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="40" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="92" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!--  Громкость плеера (логарифмическая шкала); на анализ звука не влияет  -->
                <TextBlock
                    Grid.Row="0"
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    FontFamily="Segoe MDL2 Assets"
                    FontSize="16"
                    Text="&#xE767;"
                    ToolTip="{loc:Loc music.volume.tooltip}" />
                <!--  Minimum/Maximum должны идти раньше Value  -->
                <Slider
                    Grid.Row="0"
                    Grid.Column="1"
                    Margin="0,0,0,6"
                    VerticalAlignment="Center"
                    IsMoveToPointEnabled="True"
                    LargeChange="0.1"
                    Maximum="1"
                    Minimum="0"
                    SmallChange="0.01"
                    ToolTip="{loc:Loc music.volume.tooltip}"
                    Value="{Binding VolumePosition, Mode=TwoWay}" />
                <TextBlock
                    Grid.Row="0"
                    Grid.Column="2"
                    VerticalAlignment="Center"
                    FontSize="11"
                    Text="{Binding VolumeText}"
                    TextAlignment="Right" />

                <!--  Позиция трека: тянуть можно во время воспроизведения  -->
                <TextBlock
                    Grid.Row="1"
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    FontFamily="Segoe MDL2 Assets"
                    FontSize="16"
                    Text="&#xE916;"
                    ToolTip="{loc:Loc music.position.tooltip}" />
                <Slider
                    Grid.Row="1"
                    Grid.Column="1"
                    Margin="0,0,0,6"
                    VerticalAlignment="Center"
                    IsEnabled="{Binding IsPlaying}"
                    IsMoveToPointEnabled="True"
                    LargeChange="10"
                    Maximum="{Binding DurationSeconds}"
                    Minimum="0"
                    SmallChange="1"
                    Thumb.DragCompleted="PositionSlider_DragCompleted"
                    Thumb.DragStarted="PositionSlider_DragStarted"
                    ToolTip="{loc:Loc music.position.tooltip}"
                    Value="{Binding PositionSeconds, Mode=TwoWay}" />
                <TextBlock
                    Grid.Row="1"
                    Grid.Column="2"
                    VerticalAlignment="Center"
                    FontSize="11"
                    Text="{Binding PositionText}"
                    TextAlignment="Right" />

                <!--  FPS: сколько раз в секунду обновляется изображение  -->
                <TextBlock
                    Grid.Row="2"
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    Text="{loc:Loc music.fps}"
                    ToolTip="{loc:Loc music.fps.tooltip}" />
                <!--  Границы совпадают с MusicViewModel.MinFps / MaxFps  -->
                <Slider
                    Grid.Row="2"
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    IsSnapToTickEnabled="True"
                    LargeChange="5"
                    Maximum="30"
                    Minimum="1"
                    SmallChange="1"
                    TickFrequency="1"
                    ToolTip="{loc:Loc music.fps.tooltip}"
                    Value="{Binding Fps, Mode=TwoWay}" />
                <TextBlock
                    Grid.Row="2"
                    Grid.Column="2"
                    VerticalAlignment="Center"
                    FontSize="11"
                    Text="{Binding FpsText}"
                    TextAlignment="Right" />
            </Grid>
            <!--  Play / Stop  -->
            <StackPanel Grid.Row="4" Margin="0,10,0,10" Orientation="Horizontal">
                <Button
                    Margin="0,0,8,0"
                    Padding="16,4"
                    Command="{Binding PlayCommand}"
                    Content="{loc:Loc music.play}"
                    Style="{StaticResource TextButton}" />
                <Button
                    Padding="16,4"
                    Command="{Binding StopCommand}"
                    Content="{loc:Loc music.stop}"
                    Style="{StaticResource TextButton}" />
            </StackPanel>

            <StackPanel Grid.Row="5">
                <ProgressBar
                    Height="6"
                    Margin="0,0,0,6"
                    IsIndeterminate="True"
                    Visibility="{Binding IsAnalyzing, Converter={StaticResource BoolToVisibility}}" />
                <TextBlock Text="{Binding Status}" TextWrapping="Wrap" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
