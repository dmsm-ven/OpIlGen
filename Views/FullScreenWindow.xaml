<Window x:Class="OpIlGen.Views.FullScreenWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:OpIlGen.Localization"
        Title="{loc:Loc fullscreen.title}"
        WindowStyle="None"
        WindowState="Maximized"
        ResizeMode="NoResize"
        Background="Black"
        KeyDown="Window_KeyDown"
        MouseDoubleClick="Window_MouseDoubleClick">
    <Grid>
        <Image x:Name="Picture" Stretch="Uniform" />

        <TextBlock x:Name="ResolutionText"
                   HorizontalAlignment="Right"
                   VerticalAlignment="Bottom"
                   Margin="0,0,16,12"
                   FontSize="20"
                   FontWeight="SemiBold"
                   Foreground="#B3FFEB3B"
                   IsHitTestVisible="False">
            <TextBlock.Effect>
                <DropShadowEffect ShadowDepth="0" BlurRadius="4" Color="Black" />
            </TextBlock.Effect>
        </TextBlock>
    </Grid>
</Window>
