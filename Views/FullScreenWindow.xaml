<Window x:Class="OpIlGen.Views.FullScreenWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Просмотр"
        WindowStyle="None"
        WindowState="Maximized"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="Black"
        KeyDown="OnKeyDown"
        MouseLeftButtonDown="OnMouseLeftButtonDown">
    <Grid>
        <Image x:Name="Preview" Stretch="Uniform" RenderOptions.BitmapScalingMode="Fant" />

        <TextBlock x:Name="ResolutionText"
                   HorizontalAlignment="Right"
                   VerticalAlignment="Bottom"
                   Margin="12"
                   FontSize="16"
                   FontWeight="SemiBold"
                   Foreground="#B3FFD700"
                   IsHitTestVisible="False" />
    </Grid>
</Window>
