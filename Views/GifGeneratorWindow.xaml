<Window x:Class="OpIlGen.Views.GifGeneratorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Генератор GIF-анимации"
        Width="520" Height="700"
        MinWidth="420" MinHeight="420"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource TextBrush}">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Что анимируем -->
        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock>
                <Run Text="Файл: " FontWeight="SemiBold" /><Run Text="{Binding SourceName, Mode=OneWay}" />
            </TextBlock>
            <TextBlock Margin="0,2,0,0">
                <Run Text="Преобразователь: " FontWeight="SemiBold" /><Run Text="{Binding TransformerName, Mode=OneWay}" />
            </TextBlock>
        </StackPanel>

        <!-- Панель кнопок: слева добавить кадр, справа склеить -->
        <DockPanel Grid.Row="1" Margin="0,0,0,10" LastChildFill="False">
            <Button DockPanel.Dock="Left"
                    Style="{StaticResource IconButton}"
                    Content="&#xE710;"
                    ToolTip="Добавить кадр (контрольную точку)"
                    Command="{Binding AddFrameCommand}" />
            <Button DockPanel.Dock="Right"
                    Style="{StaticResource TextButton}"
                    Content="Склеить"
                    ToolTip="Создать GIF из всех кадров"
                    Command="{Binding GenerateCommand}" />
        </DockPanel>

        <!-- Задержка между кадрами -->
        <Grid Grid.Row="2" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="Задержка кадра, мс:" VerticalAlignment="Center" Margin="0,0,10,0" />

            <!-- Minimum/Maximum должны идти раньше Value, иначе значение обрезается до 0..10 -->
            <Slider Grid.Column="1" x:Name="DelaySlider"
                    Minimum="20"
                    Maximum="2000"
                    TickFrequency="10"
                    IsSnapToTickEnabled="True"
                    Value="{Binding FrameDelayMs}"
                    IsEnabled="{Binding IsNotBusy}"
                    VerticalAlignment="Center" />

            <TextBlock Grid.Column="2"
                       Text="{Binding Value, ElementName=DelaySlider, StringFormat={}{0:0}}"
                       Width="44" TextAlignment="Right" FontWeight="SemiBold"
                       Margin="10,0,0,0" VerticalAlignment="Center" />
        </Grid>

        <!-- Кадры -->
        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" IsEnabled="{Binding IsNotBusy}">
            <StackPanel>
                <TextBlock Visibility="{Binding HasNoVariables, Converter={StaticResource BoolToVisibility}}"
                           Text="У этого преобразователя нет настраиваемых параметров, поэтому все кадры получатся одинаковыми."
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource SecondaryTextBrush}"
                           Margin="0,0,0,8" />

                <ItemsControl ItemsSource="{Binding Frames}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,0,0,8" Padding="10"
                                    BorderThickness="1" CornerRadius="6"
                                    Background="{DynamicResource PanelBackgroundBrush}"
                                    BorderBrush="{DynamicResource ControlBorderBrush}">
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,6" LastChildFill="False">
                                        <TextBlock DockPanel.Dock="Left"
                                                   Text="{Binding Number, StringFormat='Кадр {0}'}"
                                                   FontWeight="SemiBold"
                                                   VerticalAlignment="Center" />
                                        <Button DockPanel.Dock="Right"
                                                Style="{StaticResource IconButton}"
                                                Margin="0"
                                                Content="&#xE74D;"
                                                ToolTip="Удалить кадр"
                                                Command="{Binding RemoveCommand}" />
                                    </DockPanel>

                                    <ItemsControl ItemsSource="{Binding Variables}"
                                                  FontSize="11"
                                                  ItemTemplate="{StaticResource TransformerVariableTemplate}" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <!-- Статус -->
        <StackPanel Grid.Row="4" Margin="0,8,0,0">
            <ProgressBar IsIndeterminate="True" Height="4" Margin="0,0,0,6"
                         Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
            <TextBlock Text="{Binding Status}" TextWrapping="Wrap"
                       Foreground="{DynamicResource SecondaryTextBrush}" />
        </StackPanel>
    </Grid>
</Window>
