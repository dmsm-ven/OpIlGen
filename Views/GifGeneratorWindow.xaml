<Window x:Class="OpIlGen.Views.GifGeneratorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Генератор GIF-анимации"
        Width="780" Height="740"
        MinWidth="560" MinHeight="520"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource TextBrush}">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Что анимируем + кнопка "Склеить" -->
        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock>
                    <Run Text="Файл: " FontWeight="SemiBold" /><Run Text="{Binding SourceName, Mode=OneWay}" />
                </TextBlock>
                <TextBlock Margin="0,2,0,0">
                    <Run Text="Преобразователь: " FontWeight="SemiBold" /><Run Text="{Binding TransformerName, Mode=OneWay}" />
                </TextBlock>
            </StackPanel>

            <Button Grid.Column="1"
                    Style="{StaticResource TextButton}"
                    Content="Склеить"
                    VerticalAlignment="Top"
                    ToolTip="Создать GIF из всех кадров"
                    Command="{Binding GenerateCommand}" />
        </Grid>

        <!-- Задержка между кадрами -->
        <Grid Grid.Row="1" Margin="0,0,0,10" IsEnabled="{Binding IsNotBusy}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="Задержка кадра, мс:" VerticalAlignment="Center" Margin="0,0,10,0" />

            <!-- Minimum/Maximum должны идти раньше Value, иначе значение обрезается до 0..10 -->
            <Slider Grid.Column="1" x:Name="DelaySlider"
                    Minimum="20"
                    Maximum="2000"
                    TickFrequency="10"
                    IsSnapToTickEnabled="True"
                    Value="{Binding FrameDelayMs}"
                    VerticalAlignment="Center" />

            <TextBlock Grid.Column="2"
                       Text="{Binding Value, ElementName=DelaySlider, StringFormat={}{0:0}}"
                       Width="44" TextAlignment="Right" FontWeight="SemiBold"
                       Margin="10,0,0,0" VerticalAlignment="Center" />
        </Grid>

        <!-- Переход между кадрами -->
        <GroupBox Grid.Row="2" Header="Переход между кадрами" Margin="0,0,0,10" Padding="8"
                  IsEnabled="{Binding IsNotBusy}">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <RadioButton Content="Без перехода" GroupName="Transition" Margin="0,0,20,0"
                                 IsChecked="{Binding IsNoTransition}" />
                    <RadioButton Content="Плавный переход" GroupName="Transition" Margin="0,0,20,0"
                                 IsChecked="{Binding IsSmoothTransition}" />
                    <RadioButton Content="Fade-in / fade-out" GroupName="Transition"
                                 IsChecked="{Binding IsFadeTransition}" />
                </StackPanel>

                <TextBlock Text="{Binding TransitionHint}" TextWrapping="Wrap" FontSize="11" Margin="0,6,0,0"
                           Foreground="{DynamicResource SecondaryTextBrush}" />

                <Grid Margin="0,8,0,0" IsEnabled="{Binding HasTransition}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="Кадров перехода:" VerticalAlignment="Center" Margin="0,0,10,0" />

                    <Slider Grid.Column="1" x:Name="TransitionSlider"
                            Minimum="1"
                            Maximum="20"
                            TickFrequency="1"
                            IsSnapToTickEnabled="True"
                            Value="{Binding TransitionFrames}"
                            VerticalAlignment="Center" />

                    <TextBlock Grid.Column="2"
                               Text="{Binding Value, ElementName=TransitionSlider, StringFormat={}{0:0}}"
                               Width="44" TextAlignment="Right" FontWeight="SemiBold"
                               Margin="10,0,0,0" VerticalAlignment="Center" />
                </Grid>
            </StackPanel>
        </GroupBox>

        <!-- Таблица кадров: строка = кадр, столбцы = номер и параметры преобразователя -->
        <GroupBox Grid.Row="3" Header="Кадры" Padding="6">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Заголовки столбцов (те же размеры колонок, что и у строк) -->
                <Grid Grid.Row="0" Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="40" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="32" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="№" FontWeight="SemiBold"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />

                    <ItemsControl Grid.Column="1" ItemsSource="{Binding Columns}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Rows="1" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="4,0" ToolTip="{Binding Description}">
                                    <TextBlock Text="{Binding Name}" FontSize="11" FontWeight="SemiBold"
                                               TextWrapping="Wrap" TextAlignment="Center" />
                                    <TextBlock FontSize="10" TextAlignment="Center"
                                               Foreground="{DynamicResource SecondaryTextBrush}">
                                        <Run Text="{Binding MinValue, Mode=OneWay, StringFormat={}{0:0.##}}" /><Run Text=" … " /><Run Text="{Binding MaxValue, Mode=OneWay, StringFormat={}{0:0.##}}" />
                                    </TextBlock>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Место под полосу прокрутки таблицы, чтобы столбцы заголовка и строк совпадали -->
                    <Border Grid.Column="3" Width="{x:Static SystemParameters.VerticalScrollBarWidth}" />
                </Grid>

                <!-- Строки -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Visible" IsEnabled="{Binding IsNotBusy}">
                    <StackPanel>
                        <TextBlock Visibility="{Binding HasNoVariables, Converter={StaticResource BoolToVisibility}}"
                                   Text="У этого преобразователя нет настраиваемых параметров: кадры одинаковы, отличаться они могут только яркостью в режиме Fade."
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   Margin="0,0,0,8" />

                        <ItemsControl ItemsSource="{Binding Frames}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="40" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="32" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0" Text="{Binding Number}" FontWeight="SemiBold"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />

                                        <ItemsControl Grid.Column="1" ItemsSource="{Binding Cells}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <UniformGrid Rows="1" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBox Margin="4,0" Padding="4,3" TextAlignment="Center"
                                                             Text="{Binding Value, UpdateSourceTrigger=LostFocus, StringFormat={}{0:0.##}}" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <Button Grid.Column="2"
                                                Style="{StaticResource IconButton}"
                                                Margin="0"
                                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                                Content="&#xE74D;"
                                                ToolTip="Удалить кадр"
                                                Command="{Binding RemoveCommand}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>

                <!-- Кнопка "+" внизу таблицы -->
                <Button Grid.Row="2"
                        Style="{StaticResource TextButton}"
                        Content="+"
                        FontSize="16"
                        Margin="0,6,0,0"
                        HorizontalAlignment="Stretch"
                        ToolTip="Добавить кадр (контрольную точку)"
                        Command="{Binding AddFrameCommand}" />
            </Grid>
        </GroupBox>

        <!-- Итог и статус -->
        <StackPanel Grid.Row="4" Margin="0,8,0,0">
            <ProgressBar IsIndeterminate="True" Height="4" Margin="0,0,0,6"
                         Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
            <TextBlock Text="{Binding Summary}" FontWeight="SemiBold" />
            <TextBlock Text="{Binding Status}" TextWrapping="Wrap" Margin="0,2,0,0"
                       Foreground="{DynamicResource SecondaryTextBrush}" />
        </StackPanel>
    </Grid>
</Window>
