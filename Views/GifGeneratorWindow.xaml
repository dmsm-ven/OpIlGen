<Window
    x:Class="OpIlGen.Views.GifGeneratorWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="clr-namespace:OpIlGen.Localization"
    Title="{loc:Loc gif.title}"
    Width="780"
    Height="740"
    MinWidth="560"
    MinHeight="520"
    Background="{DynamicResource WindowBackgroundBrush}"
    Foreground="{DynamicResource TextBrush}"
    WindowStartupLocation="CenterOwner">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  Что анимируем + кнопка "Склеить"  -->
        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock>
                <Run FontWeight="SemiBold" Text="{loc:Loc gif.file}" /><Run Text="{Binding SourceName, Mode=OneWay}" />
            </TextBlock>
            <TextBlock Margin="0,2,0,0">
                <Run FontWeight="SemiBold" Text="{loc:Loc gif.transformer}" /><Run Text="{Binding TransformerName, Mode=OneWay}" />
            </TextBlock>
        </StackPanel>

        <!--  Задержка между кадрами  -->
        <Grid
            Grid.Row="1"
            Margin="0,0,0,10"
            IsEnabled="{Binding IsNotBusy}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock
                Grid.Column="0"
                Margin="0,0,10,0"
                VerticalAlignment="Center"
                Text="{loc:Loc gif.delay}" />

            <!--  Minimum/Maximum должны идти раньше Value, иначе значение обрезается до 0..10  -->
            <Slider
                x:Name="DelaySlider"
                Grid.Column="1"
                VerticalAlignment="Center"
                IsSnapToTickEnabled="True"
                Maximum="2000"
                Minimum="20"
                TickFrequency="10"
                Value="{Binding FrameDelayMs}" />

            <TextBlock
                Grid.Column="2"
                Width="44"
                Margin="10,0,0,0"
                VerticalAlignment="Center"
                FontWeight="SemiBold"
                Text="{Binding Value, ElementName=DelaySlider, StringFormat={}{0:0}}"
                TextAlignment="Right" />
        </Grid>

        <!--  Переход между кадрами  -->
        <GroupBox
            Grid.Row="2"
            Margin="0,0,0,10"
            Padding="8"
            Header="{loc:Loc gif.transition.header}"
            IsEnabled="{Binding IsNotBusy}">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <RadioButton
                        Margin="0,0,20,0"
                        Content="{loc:Loc gif.transition.none}"
                        GroupName="Transition"
                        IsChecked="{Binding IsNoTransition}" />
                    <RadioButton
                        Margin="0,0,20,0"
                        Content="{loc:Loc gif.transition.smooth}"
                        GroupName="Transition"
                        IsChecked="{Binding IsSmoothTransition}" />
                    <RadioButton
                        Content="{loc:Loc gif.transition.fade}"
                        GroupName="Transition"
                        IsChecked="{Binding IsFadeTransition}" />
                </StackPanel>

                <TextBlock
                    Margin="0,6,0,0"
                    FontSize="11"
                    Foreground="{DynamicResource SecondaryTextBrush}"
                    Text="{Binding TransitionHint}"
                    TextWrapping="Wrap" />

                <Grid Margin="0,8,0,0" IsEnabled="{Binding HasTransition}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock
                        Grid.Column="0"
                        Margin="0,0,10,0"
                        VerticalAlignment="Center"
                        Text="{loc:Loc gif.transition.frames}" />

                    <Slider
                        x:Name="TransitionSlider"
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        IsSnapToTickEnabled="True"
                        Maximum="20"
                        Minimum="1"
                        TickFrequency="1"
                        Value="{Binding TransitionFrames}" />

                    <TextBlock
                        Grid.Column="2"
                        Width="44"
                        Margin="10,0,0,0"
                        VerticalAlignment="Center"
                        FontWeight="SemiBold"
                        Text="{Binding Value, ElementName=TransitionSlider, StringFormat={}{0:0}}"
                        TextAlignment="Right" />
                </Grid>
            </StackPanel>
        </GroupBox>

        <!--  Таблица кадров: строка = кадр, столбцы = номер и параметры преобразователя  -->
        <GroupBox
            Grid.Row="3"
            Padding="6"
            Header="{loc:Loc gif.frames.header}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!--  Заголовки столбцов (те же размеры колонок, что и у строк)  -->
                <Grid Grid.Row="0" Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="40" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="32" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock
                        Grid.Column="0"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontWeight="SemiBold"
                        Text="№" />

                    <ItemsControl Grid.Column="1" ItemsSource="{Binding Columns}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Rows="1" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="4,0" ToolTip="{Binding Description}">
                                    <TextBlock
                                        FontSize="11"
                                        FontWeight="SemiBold"
                                        Text="{Binding Name}"
                                        TextAlignment="Center"
                                        TextWrapping="Wrap" />
                                    <TextBlock
                                        FontSize="10"
                                        Foreground="{DynamicResource SecondaryTextBrush}"
                                        TextAlignment="Center">
                                        <Run Text="{Binding MinValue, Mode=OneWay, StringFormat={}{0:0.##}}" /><Run Text=" … " /><Run Text="{Binding MaxValue, Mode=OneWay, StringFormat={}{0:0.##}}" />
                                    </TextBlock>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!--  Место под полосу прокрутки таблицы, чтобы столбцы заголовка и строк совпадали  -->
                    <Border Grid.Column="3" Width="{x:Static SystemParameters.VerticalScrollBarWidth}" />
                </Grid>

                <!--  Строки  -->
                <ScrollViewer
                    Grid.Row="1"
                    IsEnabled="{Binding IsNotBusy}"
                    VerticalScrollBarVisibility="Visible">
                    <StackPanel>
                        <TextBlock
                            Margin="0,0,0,8"
                            Foreground="{DynamicResource SecondaryTextBrush}"
                            Text="{loc:Loc gif.no_variables_notice}"
                            TextWrapping="Wrap"
                            Visibility="{Binding HasNoVariables, Converter={StaticResource BoolToVisibility}}" />

                        <ItemsControl ItemsSource="{Binding Frames}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="40" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="32" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock
                                            Grid.Column="0"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            FontWeight="SemiBold"
                                            Text="{Binding Number}" />

                                        <ItemsControl Grid.Column="1" ItemsSource="{Binding Cells}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <UniformGrid Rows="1" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBox
                                                        Margin="4,0"
                                                        Padding="4,3"
                                                        Text="{Binding Value, UpdateSourceTrigger=LostFocus, StringFormat={}{0:0.##}}"
                                                        TextAlignment="Center" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <Button
                                            Grid.Column="2"
                                            Margin="0"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Command="{Binding RemoveCommand}"
                                            Content="&#xE74D;"
                                            Style="{StaticResource IconButton}"
                                            ToolTip="{loc:Loc gif.frame.remove}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>

                <Grid Grid.Row="2" Margin="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <!--  Кнопка "+" внизу таблицы  -->
                    <Button
                        Grid.Column="0"
                        Margin="2"
                        Command="{Binding AddFrameCommand}"
                        Content="{loc:Loc gif.frame.add}"
                        Style="{StaticResource TextButton}"
                        ToolTip="{loc:Loc gif.frame.add.tooltip}" />

                    <Button
                        Grid.Column="1"
                        Margin="2"
                        Command="{Binding GenerateCommand}"
                        Content="{loc:Loc gif.generate}"
                        Style="{StaticResource TextButton}"
                        ToolTip="{loc:Loc gif.generate.tooltip}" />
                </Grid>
            </Grid>
        </GroupBox>

        <!--  Итог и статус  -->
        <StackPanel Grid.Row="4" Margin="0,8,0,0">
            <ProgressBar
                Height="4"
                Margin="0,0,0,6"
                IsIndeterminate="True"
                Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
            <TextBlock FontWeight="SemiBold" Text="{Binding Summary}" />
            <TextBlock
                Margin="0,2,0,0"
                Foreground="{DynamicResource SecondaryTextBrush}"
                Text="{Binding Status}"
                TextWrapping="Wrap" />
        </StackPanel>
    </Grid>
</Window>
