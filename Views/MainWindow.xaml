<Window x:Class="OpIlGen.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding WindowTitle}"
        Width="1000" Height="700"
        MinWidth="600" MinHeight="400"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="40" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="20" />
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Панель кнопок -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
            <Button Style="{StaticResource IconButton}"
                    Content="&#xE838;"
                    ToolTip="Выбрать файл (.jpg / .png)"
                    Command="{Binding SelectFileCommand}" />
            <Button Style="{StaticResource IconButton}"
                    Content="&#xE740;"
                    ToolTip="Во весь экран"
                    Command="{Binding OpenFullScreenCommand}" />
        </StackPanel>

        <!-- Холст (5*) и список преобразователей (3*) -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="5*" />
                <ColumnDefinition Width="3*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Margin="0,0,12,0"
                    BorderBrush="Gray" BorderThickness="1" Background="#FFEEEEEE">
                <Grid>
                    <Canvas x:Name="ResultCanvas" ClipToBounds="True">
                        <Image Source="{Binding ResultImage}"
                               Stretch="Uniform"
                               Width="{Binding ActualWidth, ElementName=ResultCanvas}"
                               Height="{Binding ActualHeight, ElementName=ResultCanvas}" />
                    </Canvas>

                    <!-- Разрешение поверх холста -->
                    <TextBlock Text="{Binding ImageResolution}"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Bottom"
                               Margin="8"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="#B3FFD700"
                               IsHitTestVisible="False">
                        <TextBlock.Effect>
                            <DropShadowEffect Color="Black" BlurRadius="4" ShadowDepth="0" Opacity="0.8" />
                        </TextBlock.Effect>
                    </TextBlock>
                </Grid>
            </Border>

            <ListBox Grid.Column="1"
                     ItemsSource="{Binding Transformers}"
                     SelectedItem="{Binding SelectedTransformer}"
                     DisplayMemberPath="Name"
                     FontSize="14" />
        </Grid>

        <!-- Описание выбранного преобразователя -->
        <TextBlock Grid.Row="2"
                   Text="{Binding SelectedTransformer.Description}"
                   TextWrapping="Wrap"
                   MinHeight="40"
                   Margin="0,8,0,0" />
    </Grid>
</Window>
