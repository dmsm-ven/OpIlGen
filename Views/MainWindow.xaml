<Window x:Class="OpIlGen.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:OpIlGen.Localization"
        Title="{Binding Title}"
        Width="1100" Height="700"
        MinWidth="600" MinHeight="400"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource TextBrush}">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Верхняя панель: слева действия, справа настройки -->
        <DockPanel Grid.Row="0" Margin="0,0,0,10" LastChildFill="False">
            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                <Button Style="{StaticResource IconButton}"
                        Content="&#xE8E5;"
                        ToolTip="{loc:Loc main.select_file}"
                        Command="{Binding SelectFileCommand}" />
                <Button Style="{StaticResource IconButton}"
                        Content="&#xE740;"
                        ToolTip="{loc:Loc main.fullscreen}"
                        Command="{Binding ShowFullScreenCommand}" />
                <Button Style="{StaticResource IconButton}"
                        Content="&#xE838;"
                        ToolTip="{loc:Loc main.open_folder}"
                        Command="{Binding OpenOutputFolderCommand}" />
                <Button Style="{StaticResource IconButton}"
                        Content="&#xE768;"
                        ToolTip="{loc:Loc main.gif_generator}"
                        Command="{Binding OpenGifGeneratorCommand}" />
            </StackPanel>

            <Button DockPanel.Dock="Right"
                    Style="{StaticResource IconButton}"
                    Margin="0"
                    Content="&#xE713;"
                    ToolTip="{loc:Loc main.settings}"
                    Command="{Binding OpenSettingsCommand}" />
        </DockPanel>

        <!-- Холст (5*) и список преобразователей (1.5*) -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="5*" />
                <ColumnDefinition Width="1.5*" />
            </Grid.ColumnDefinitions>

            <!-- Фон холста всегда тёмный: нейтральный фон для просмотра изображения -->
            <Border Grid.Column="0" Margin="0,0,12,0"
                    BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1"
                    Background="#FF202020">
                <Grid>
                    <Canvas x:Name="ResultCanvas" ClipToBounds="True">
                        <Image Source="{Binding ResultImage}"
                               Stretch="Uniform"
                               Width="{Binding ActualWidth, ElementName=ResultCanvas}"
                               Height="{Binding ActualHeight, ElementName=ResultCanvas}" />
                    </Canvas>

                    <!-- Разрешение поверх холста -->
                    <TextBlock Text="{Binding ResolutionText}"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Bottom"
                               Margin="0,0,10,6"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Foreground="#B3FFEB3B"
                               IsHitTestVisible="False">
                        <TextBlock.Effect>
                            <DropShadowEffect ShadowDepth="0" BlurRadius="4" Color="Black" />
                        </TextBlock.Effect>
                    </TextBlock>
                </Grid>
            </Border>

            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <GroupBox Grid.Row="0" Header="{loc:Loc main.transformers}" Padding="2">
                    <ListBox ItemsSource="{Binding Transformers}"
                             SelectedValuePath="Transformer"
                             SelectedValue="{Binding SelectedTransformer}"
                             FontSize="11"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name}" TextWrapping="Wrap" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </GroupBox>

                <!-- Настраиваемые параметры выбранного преобразователя -->
                <GroupBox Grid.Row="1" Header="{loc:Loc main.parameters}" Margin="0,8,0,0" Padding="6"
                          Visibility="{Binding HasCustomVariables, Converter={StaticResource BoolToVisibility}}">
                    <ItemsControl ItemsSource="{Binding CustomVariables}" FontSize="11"
                                  ItemTemplate="{StaticResource TransformerVariableTemplate}" />
                </GroupBox>
            </Grid>
        </Grid>

        <!-- Описание выбранной иллюзии -->
        <TextBlock Grid.Row="2"
                   Text="{Binding SelectedDescription}"
                   MinHeight="40"
                   Margin="0,8,0,0"
                   TextWrapping="Wrap"
                   Foreground="{DynamicResource SecondaryTextBrush}" />
    </Grid>
</Window>
