<Window x:Class="OpIlGen.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Title}"
        Width="1100" Height="700"
        MinWidth="600" MinHeight="400"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <!-- Кнопка-иконка (глифы Segoe MDL2 Assets) -->
        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="20" />
            <Setter Property="Width" Value="44" />
            <Setter Property="Height" Value="44" />
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Панель кнопок -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
            <Button Style="{StaticResource IconButton}"
                    Content="&#xE838;"
                    ToolTip="Выбрать файл (.jpg / .png)"
                    Command="{Binding SelectFileCommand}" />
            <Button Style="{StaticResource IconButton}"
                    Content="&#xE740;"
                    ToolTip="Во весь экран"
                    Command="{Binding ShowFullScreenCommand}" />
        </StackPanel>

        <!-- Холст (5*) и список преобразователей (3*) -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="5*" />
                <ColumnDefinition Width="3*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Margin="0,0,12,0"
                    BorderBrush="Gray" BorderThickness="1" Background="#FF202020">
                <Grid>
                    <Canvas x:Name="ResultCanvas" ClipToBounds="True">
                        <Image Source="{Binding ResultImage}"
                               Stretch="Uniform"
                               Width="{Binding ActualWidth, ElementName=ResultCanvas}"
                               Height="{Binding ActualHeight, ElementName=ResultCanvas}" />
                    </Canvas>

                    <!-- Разрешение поверх холста -->
                    <TextBlock Text="{Binding ResolutionText}"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Bottom"
                               Margin="0,0,10,6"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Foreground="#B3FFEB3B"
                               IsHitTestVisible="False">
                        <TextBlock.Effect>
                            <DropShadowEffect ShadowDepth="0" BlurRadius="4" Color="Black" />
                        </TextBlock.Effect>
                    </TextBlock>
                </Grid>
            </Border>

            <GroupBox Grid.Column="1" Header="Преобразования" Padding="4">
                <ListBox ItemsSource="{Binding Transformers}"
                         SelectedItem="{Binding SelectedTransformer}"
                         DisplayMemberPath="Name"
                         BorderThickness="0">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="8,6" />
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>
            </GroupBox>
        </Grid>

        <!-- Описание выбранной иллюзии -->
        <TextBlock Grid.Row="2"
                   Text="{Binding SelectedTransformer.Description}"
                   MinHeight="40"
                   Margin="0,8,0,0"
                   TextWrapping="Wrap"
                   Foreground="DimGray" />
    </Grid>
</Window>
