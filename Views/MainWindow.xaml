<Window x:Class="OpIlGen.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Title}"
        Width="1100" Height="700"
        MinWidth="600" MinHeight="400"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <!-- Кнопка-иконка: прозрачная, со скруглёнными углами (глифы Segoe MDL2 Assets) -->
        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Width" Value="26" />
            <Setter Property="Height" Value="26" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBrush}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource PressedBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.35" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Кнопки тем: активная тема подсвечена -->
        <Style x:Key="LightThemeButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsDarkTheme}" Value="False">
                    <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="DarkThemeButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsDarkTheme}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Верхняя панель: слева действия, справа переключение темы -->
        <DockPanel Grid.Row="0" Margin="0,0,0,10" LastChildFill="False">
            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                <Button Style="{StaticResource IconButton}"
                        Content="&#xE8E5;"
                        ToolTip="Выбрать файл (.jpg / .png)"
                        Command="{Binding SelectFileCommand}" />
                <Button Style="{StaticResource IconButton}"
                        Content="&#xE740;"
                        ToolTip="Во весь экран"
                        Command="{Binding ShowFullScreenCommand}" />
                <Button Style="{StaticResource IconButton}"
                        Content="&#xE838;"
                        ToolTip="Открыть папку с изображениями"
                        Command="{Binding OpenOutputFolderCommand}" />
            </StackPanel>

            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Style="{StaticResource LightThemeButton}"
                        Content="&#xE706;"
                        ToolTip="Светлая тема"
                        Command="{Binding SetLightThemeCommand}" />
                <Button Style="{StaticResource DarkThemeButton}"
                        Content="&#xE708;"
                        Margin="0"
                        ToolTip="Тёмная тема"
                        Command="{Binding SetDarkThemeCommand}" />
            </StackPanel>
        </DockPanel>

        <!-- Холст (5*) и список преобразователей (1.5*) -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="5*" />
                <ColumnDefinition Width="1.5*" />
            </Grid.ColumnDefinitions>

            <!-- Фон холста всегда тёмный: нейтральный фон для просмотра изображения -->
            <Border Grid.Column="0" Margin="0,0,12,0"
                    BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1"
                    Background="#FF202020">
                <Grid>
                    <Canvas x:Name="ResultCanvas" ClipToBounds="True">
                        <Image Source="{Binding ResultImage}"
                               Stretch="Uniform"
                               Width="{Binding ActualWidth, ElementName=ResultCanvas}"
                               Height="{Binding ActualHeight, ElementName=ResultCanvas}" />
                    </Canvas>

                    <!-- Разрешение поверх холста -->
                    <TextBlock Text="{Binding ResolutionText}"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Bottom"
                               Margin="0,0,10,6"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Foreground="#B3FFEB3B"
                               IsHitTestVisible="False">
                        <TextBlock.Effect>
                            <DropShadowEffect ShadowDepth="0" BlurRadius="4" Color="Black" />
                        </TextBlock.Effect>
                    </TextBlock>
                </Grid>
            </Border>

            <GroupBox Grid.Column="1" Header="Преобразования" Padding="2">
                <ListBox ItemsSource="{Binding Transformers}"
                         SelectedItem="{Binding SelectedTransformer}"
                         FontSize="11"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Name}" TextWrapping="Wrap" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </GroupBox>
        </Grid>

        <!-- Описание выбранной иллюзии -->
        <TextBlock Grid.Row="2"
                   Text="{Binding SelectedTransformer.Description}"
                   MinHeight="40"
                   Margin="0,8,0,0"
                   TextWrapping="Wrap"
                   Foreground="{DynamicResource SecondaryTextBrush}" />
    </Grid>
</Window>
