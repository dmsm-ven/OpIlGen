<Window
    x:Class="OpIlGen.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:iconsPack="http://metro.mahapps.com/winfx/xaml/iconpacks"
    xmlns:loc="clr-namespace:OpIlGen.Localization"
    Title="{Binding Title}"
    Width="1100"
    Height="700"
    MinWidth="600"
    MinHeight="400"
    Background="{DynamicResource WindowBackgroundBrush}"
    Foreground="{DynamicResource TextBrush}"
    WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <!--  Плитка недавнего изображения: квадрат со скруглением; текущий выделен рамкой цвета выделения  -->
        <Style x:Key="RecentImageTile" TargetType="Button">
            <Setter Property="Width" Value="42" />
            <Setter Property="Height" Value="42" />
            <Setter Property="Margin" Value="3" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border
                                x:Name="Bd"
                                Background="{DynamicResource HoverBrush}"
                                BorderBrush="{DynamicResource ControlBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="10" />
                            <Border
                                x:Name="Hl"
                                Background="Transparent"
                                CornerRadius="10" />
                            <iconsPack:PackIconMaterial
                                Width="20"
                                Height="20"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Foreground="{DynamicResource TextBrush}"
                                Kind="FileJpgBox" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Hl" Property="Background" Value="{DynamicResource HoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Hl" Property="Background" Value="{DynamicResource PressedBrush}" />
                            </Trigger>
                            <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource SelectionBrush}" />
                                <Setter TargetName="Bd" Property="BorderThickness" Value="2" />
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SelectionBrush}" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  Кнопка «Оригинальное фото» над списком преобразователей; выбранная подсвечена цветом выделения  -->
        <Style x:Key="OriginalButton" TargetType="Button">
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border
                                x:Name="Bd"
                                Background="{DynamicResource PanelBackgroundBrush}"
                                BorderBrush="{DynamicResource ControlBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8" />
                            <Border
                                x:Name="Hl"
                                Background="Transparent"
                                CornerRadius="8" />
                            <TextBlock
                                Margin="{TemplateBinding Padding}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Foreground="{TemplateBinding Foreground}"
                                Text="{Binding OriginalItem.Name}"
                                TextTrimming="CharacterEllipsis" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Hl" Property="Background" Value="{DynamicResource HoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Hl" Property="Background" Value="{DynamicResource PressedBrush}" />
                            </Trigger>
                            <DataTrigger Binding="{Binding IsOriginalSelected}" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource SelectionBrush}" />
                                <Setter TargetName="Bd" Property="BorderThickness" Value="2" />
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SelectionBrush}" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  Верхняя панель: слева действия, справа настройки  -->
        <DockPanel
            Grid.Row="0"
            Margin="0,0,0,10"
            LastChildFill="False">
            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                <Button
                    Command="{Binding SelectFileCommand}"
                    Style="{StaticResource IconButton}"
                    ToolTip="{loc:Loc main.select_file}">
                    <iconsPack:PackIconMaterial Kind="FileJpgBox" />
                </Button>
                <Button
                    Command="{Binding OpenOutputFolderCommand}"
                    Style="{StaticResource IconButton}"
                    ToolTip="{loc:Loc main.open_folder}">
                    <iconsPack:PackIconMaterial Kind="OpenInApp" />
                </Button>
                <Button
                    Command="{Binding OpenGifGeneratorCommand}"
                    Style="{StaticResource IconButton}"
                    ToolTip="{loc:Loc main.gif_generator}">
                    <iconsPack:PackIconMaterial Kind="Motion" />
                </Button>
                <Button
                    Command="{Binding OpenMusicWindowCommand}"
                    Style="{StaticResource IconButton}"
                    ToolTip="{loc:Loc main.music}">
                    <iconsPack:PackIconMaterial Kind="Play" />
                </Button>
            </StackPanel>

            <Button
                Margin="0"
                Command="{Binding OpenSettingsCommand}"
                DockPanel.Dock="Right"
                Style="{StaticResource IconButton}"
                ToolTip="{loc:Loc main.settings}">
                <iconsPack:PackIconMaterial Kind="Cog" />
            </Button>
        </DockPanel>

        <!--  Недавние изображения (до 8). Первое - выбранное сейчас  -->
        <Border
            Grid.Row="1"
            Height="60"
            Margin="0,0,0,8"
            Padding="4"
            Background="{DynamicResource PanelBackgroundBrush}"
            BorderBrush="{DynamicResource ControlBorderBrush}"
            BorderThickness="1"
            CornerRadius="8">
            <Grid>
                <TextBlock
                    Margin="8,0"
                    VerticalAlignment="Center"
                    Opacity="0.6"
                    Text="{loc:Loc main.recent.empty}"
                    TextTrimming="CharacterEllipsis"
                    Visibility="{Binding HasNoRecentImages, Converter={StaticResource BoolToVisibility}}" />
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding RecentImages}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button
                                    Command="{Binding DataContext.SelectRecentCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}"
                                    Style="{StaticResource RecentImageTile}"
                                    ToolTip="{Binding ToolTipText}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>

        <!--  Холст (5*) и список преобразователей (1.5*)  -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="5*" />
                <ColumnDefinition Width="1.5*" />
            </Grid.ColumnDefinitions>

            <!--  Фон холста всегда тёмный: нейтральный фон для просмотра изображения  -->
            <Border
                Grid.Column="0"
                Margin="0,0,12,0"
                Background="#FF202020"
                BorderBrush="{DynamicResource ControlBorderBrush}"
                BorderThickness="1">
                <!--  Двойной клик по изображению открывает его на весь экран  -->
                <Border.InputBindings>
                    <MouseBinding Command="{Binding ShowFullScreenCommand}" Gesture="LeftDoubleClick" />
                </Border.InputBindings>
                <Grid>
                    <Canvas x:Name="ResultCanvas" ClipToBounds="True">
                        <Image
                            Width="{Binding ActualWidth, ElementName=ResultCanvas}"
                            Height="{Binding ActualHeight, ElementName=ResultCanvas}"
                            Source="{Binding ResultImage}"
                            Stretch="Uniform" />
                    </Canvas>

                    <!--  Разрешение поверх холста  -->
                    <TextBlock
                        Margin="0,0,10,6"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Bottom"
                        FontSize="16"
                        FontWeight="SemiBold"
                        Foreground="#B3FFEB3B"
                        IsHitTestVisible="False"
                        Text="{Binding ResolutionText}">
                        <TextBlock.Effect>
                            <DropShadowEffect
                                BlurRadius="4"
                                ShadowDepth="0"
                                Color="Black" />
                        </TextBlock.Effect>
                    </TextBlock>
                </Grid>
            </Border>

            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!--  «Оригинальное фото» вне списка: без звёздочки «избранное», всегда выше заголовка  -->
                <Button
                    Grid.Row="0"
                    Command="{Binding SelectOriginalCommand}"
                    Style="{StaticResource OriginalButton}"
                    ToolTip="{Binding OriginalItem.Description}"
                    Visibility="{Binding HasOriginal, Converter={StaticResource BoolToVisibility}}" />

                <GroupBox
                    Grid.Row="1"
                    Padding="2"
                    Header="{loc:Loc main.transformers}">
                    <ListBox
                        FontSize="11"
                        ItemsSource="{Binding Transformers}"
                        ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                        SelectedValue="{Binding SelectedTransformer}"
                        SelectedValuePath="Transformer">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <DockPanel>
                                    <!-- Звёздочка: избранный преобразователь закрепляется вверху списка -->
                                    <ToggleButton
                                        Margin="0,0,6,0"
                                        DockPanel.Dock="Left"
                                        IsChecked="{Binding IsFavorite}"
                                        Style="{StaticResource FavoriteToggle}"
                                        ToolTip="{loc:Loc main.favorite}" />
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        Text="{Binding Name}"
                                        TextWrapping="Wrap" />
                                </DockPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </GroupBox>

                <!--  Настраиваемые параметры выбранного преобразователя  -->
                <GroupBox
                    Grid.Row="2"
                    Margin="0,8,0,0"
                    Padding="6"
                    Header="{loc:Loc main.parameters}"
                    Visibility="{Binding HasCustomVariables, Converter={StaticResource BoolToVisibility}}">
                    <ItemsControl
                        FontSize="11"
                        ItemTemplate="{StaticResource TransformerVariableTemplate}"
                        ItemsSource="{Binding CustomVariables}" />
                </GroupBox>
            </Grid>
        </Grid>

        <!--  Описание выбранной иллюзии  -->
        <TextBlock
            Grid.Row="3"
            MinHeight="40"
            Margin="0,8,0,0"
            Foreground="{DynamicResource SecondaryTextBrush}"
            Text="{Binding SelectedDescription}"
            TextWrapping="Wrap" />
    </Grid>
</Window>
