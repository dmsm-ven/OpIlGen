<Window
    x:Class="OpIlGen.Views.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:iconsPack="http://metro.mahapps.com/winfx/xaml/iconpacks"
    xmlns:loc="clr-namespace:OpIlGen.Localization"
    Title="{loc:Loc settings.title}"
    Width="340"
    Background="{DynamicResource WindowBackgroundBrush}"
    Foreground="{DynamicResource TextBrush}"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    SizeToContent="Height"
    WindowStartupLocation="CenterOwner">

    <StackPanel Margin="16">
        <!--  Тема  -->
        <GroupBox
            Margin="0,0,0,12"
            Padding="8"
            Header="{loc:Loc settings.theme}">
            <StackPanel>
                <RadioButton
                    Margin="0,0,0,6"
                    Content="{loc:Loc settings.theme.light}"
                    GroupName="Theme"
                    IsChecked="{Binding IsLightTheme}" />
                <RadioButton
                    Content="{loc:Loc settings.theme.dark}"
                    GroupName="Theme"
                    IsChecked="{Binding IsDarkTheme}" />
            </StackPanel>
        </GroupBox>

        <!--  Язык: список строится из найденных языковых файлов (Localization/*.json)  -->
        <GroupBox
            Margin="0,0,0,12"
            Padding="4"
            Header="{loc:Loc settings.language}">
            <ListBox
                DisplayMemberPath="DisplayName"
                ItemsSource="{Binding Languages}"
                SelectedItem="{Binding SelectedLanguage}" />
        </GroupBox>

        <!--  Файл настроек: путь (можно выделить и скопировать) и кнопка «открыть» только для просмотра  -->
        <GroupBox Padding="8" Header="{loc:Loc settings.file}">
            <DockPanel LastChildFill="True">
                <Button
                    Margin="8,0,0,0"
                    VerticalAlignment="Center"
                    Command="{Binding OpenSettingsFileCommand}"
                    DockPanel.Dock="Right"
                    Style="{StaticResource IconButton}"
                    ToolTip="{loc:Loc settings.file.open}">
                    <iconsPack:PackIconMaterial Kind="FileOutline" />
                </Button>
                <TextBox
                    VerticalContentAlignment="Center"
                    IsReadOnly="True"
                    Text="{Binding SettingsFilePath, Mode=OneWay}"
                    TextWrapping="Wrap"
                    ToolTip="{Binding SettingsFilePath}" />
            </DockPanel>
        </GroupBox>
    </StackPanel>
</Window>
